import heapq

graph = {
    'A': [('B', 1), ('C', 3)],
    'B': [('D', 2), ('E', 4)],
    'C': [('F', 2)],
    'D': [],
    'E': [('G', 2)],
    'F': [('G', 1)],
    'G': []
}

h = {'A': 5, 'B': 4, 'C': 3, 'D': 3,
     'E': 2, 'F': 1, 'G': 0}

def astar(start, goal):
    queue = [(h[start], 0, start, [start])]

    while queue:
        f, cost, node, path = heapq.heappop(queue)

        if node == goal:
            print("Path:", path)
            print("Cost:", cost)
            return

        for neighbor, weight in graph[node]:
            new_cost = cost + weight
            heapq.heappush(queue, (
                new_cost + h[neighbor],
                new_cost,
                neighbor,
                path + [neighbor]
            ))

astar('A', 'G')
